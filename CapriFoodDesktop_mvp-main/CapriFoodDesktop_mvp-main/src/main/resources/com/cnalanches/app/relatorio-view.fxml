<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cnalanches.app.controller.RelatorioController"
      prefHeight="650.0" prefWidth="1000.0" spacing="14.0"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
    </padding>

    <!-- Topo -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Voltar" onAction="#voltarParaHome"
                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
        <Label text="Relatório de vendas"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
        
        <Button fx:id="btnExcel" text="Exportar Excel" onAction="#exportarExcel"
        style="-fx-background-color: #1d6f42; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
        
        
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <Label fx:id="lblStatus" style="-fx-text-fill: #777777;" />
        </HBox>
    </HBox>

    <!-- Filtro -->
    <HBox spacing="10.0" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;">
        <Label text="De" style="-fx-text-fill: #555555; -fx-font-weight: bold;" />
        <DatePicker fx:id="dpInicio" prefWidth="140.0" />
        <Label text="até" style="-fx-text-fill: #555555; -fx-font-weight: bold;" />
        <DatePicker fx:id="dpFim" prefWidth="140.0" />
        <Button fx:id="btnFiltrar" text="Filtrar" onAction="#filtrar"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="8.0">
            <Button text="Hoje" onAction="#periodoHoje"
                    style="-fx-background-color: #e9ecef; -fx-font-weight: bold; -fx-background-radius: 6;" />
            <Button text="Últimos 7 dias" onAction="#periodo7Dias"
                    style="-fx-background-color: #e9ecef; -fx-font-weight: bold; -fx-background-radius: 6;" />
            <Button text="Este mês" onAction="#periodoMes"
                    style="-fx-background-color: #e9ecef; -fx-font-weight: bold; -fx-background-radius: 6;" />
        </HBox>
    </HBox>

    <!-- Resumo -->
    <HBox spacing="14.0">
        <VBox HBox.hgrow="ALWAYS" spacing="4.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Total vendido" style="-fx-text-fill: #777777; -fx-font-size: 12px;" />
            <Label fx:id="lblTotal" text="R$ 0,00"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #28a745;" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="4.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Nº de vendas" style="-fx-text-fill: #777777; -fx-font-size: 12px;" />
            <Label fx:id="lblQtd" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="4.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Ticket médio" style="-fx-text-fill: #777777; -fx-font-size: 12px;" />
            <Label fx:id="lblTicket" text="R$ 0,00"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;" />
        </VBox>
    </HBox>

    <!-- Por pagamento e por tipo -->
    <HBox spacing="14.0">
        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Por forma de pagamento" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <HBox><Label text="Dinheiro" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="lblDinheiro" text="R$ 0,00" style="-fx-font-weight: bold;" /></HBox>
            <HBox><Label text="Pix" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="lblPix" text="R$ 0,00" style="-fx-font-weight: bold;" /></HBox>
            <HBox><Label text="Cartão" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="lblCartao" text="R$ 0,00" style="-fx-font-weight: bold;" /></HBox>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Por tipo de venda" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <HBox><Label text="Caixa" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="lblCaixa" text="R$ 0,00" style="-fx-font-weight: bold;" /></HBox>
            <HBox><Label text="Mesa" HBox.hgrow="ALWAYS" maxWidth="Infinity" /><Label fx:id="lblMesa" text="R$ 0,00" style="-fx-font-weight: bold;" /></HBox>
        </VBox>
    </HBox>

    <!-- Lista de vendas -->
    <Label text="Vendas do período (clique para ver os itens)"
           style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="listaVendas" spacing="6.0" />
    </ScrollPane>
</VBox>