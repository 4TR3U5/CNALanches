<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cnalanches.app.controller.HomeController"
      alignment="CENTER" 
      prefHeight="500.0" 
      prefWidth="700.0" 
      spacing="30.0"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <!-- Título Principal -->
    <Label text="Painel Principal" 
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

    <!-- Grid com as 4 opções principais -->
    <GridPane hgap="20.0" vgap="20.0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="220.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="220.0" />
        </columnConstraints>
        
        <rowConstraints>
            <RowConstraints minHeight="100.0" prefHeight="120.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="100.0" prefHeight="120.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <children>
            <!-- Cadastro de Itens com evento ligado -->
            <Button text="📦 Cadastro de Itens" 
                    onAction="#abrirCadastro"
                    GridPane.columnIndex="0" 
                    GridPane.rowIndex="0"
                    maxWidth="1.7976931348623157E308" 
                    maxHeight="1.7976931348623157E308"
                    style="-fx-font-size: 16px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />

            <!-- Controle de Estoque -->
            <Button text="📊 Controle de Estoque" 
                    onAction="#abrirEstoque"
                    GridPane.columnIndex="1" 
                    GridPane.rowIndex="0"
                    maxWidth="1.7976931348623157E308" 
                    maxHeight="1.7976931348623157E308"
                    style="-fx-font-size: 16px; -fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />

            <!-- Venda -->
            <Button text="🛒 Venda (PDV)" 
                    GridPane.columnIndex="0" 
                     onAction="#abrirPdv"
                    GridPane.rowIndex="1"
                    maxWidth="1.7976931348623157E308" 
                    maxHeight="1.7976931348623157E308"
                    style="-fx-font-size: 16px; -fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />

            <!-- Relatório -->
            <Button text="📈 Relatórios" 
                    GridPane.columnIndex="1" 
                    GridPane.rowIndex="1"
                    onAction="#abrirRelatorio"
                    maxWidth="1.7976931348623157E308" 
                    maxHeight="1.7976931348623157E308"
                    style="-fx-font-size: 16px; -fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
        </children>
    </GridPane>

</VBox>